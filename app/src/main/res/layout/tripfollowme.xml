<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TripFollowActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toplevel"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="#A0FFFFFF"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:fontWeight="700"
            android:text="Following"
            android:textAlignment="center"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="41dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="36dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/broadcast" />


    </androidx.constraintlayout.widget.ConstraintLayout>



    <TextView
        android:id="@+id/network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:background="#FF0000"
        android:elevation="10dp"
        android:visibility="gone"
        android:text="NO NETWORK CONNECTION\nNot all data may be received"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toplevel" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="411dp"
        android:layout_height="0dp"

        app:layout_constraintBottom_toTopOf="@id/bottom_info_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
android:id="@+id/bottom_info_section"
android:layout_width="match_parent"
android:layout_height="125dp"


android:background="#EEEEEE"

app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@+id/map">

<!-- Total Distance -->

<!-- Current Speed -->

<TextView
    android:id="@+id/text_trip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="124dp"
    android:layout_marginTop="16dp"
    android:text="Trip Id:"
    android:textAlignment="center"
    android:textSize="16sp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

<TextView
    android:id="@+id/text_distance"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="15dp"
    android:text="Total Distance:"
    android:textSize="16sp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/text_trip" />

<TextView
    android:id="@+id/text_elapsed"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:layout_marginEnd="41dp"
    android:text="Elapsed:"
    android:textAlignment="center"
    android:textSize="16sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/text_trip" />

<TextView
    android:id="@+id/text_start"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="124dp"
    android:layout_marginTop="8dp"
    android:text="Trip Start:"
    android:textAlignment="center"
    android:textSize="16sp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/text_distance" />

<!-- Time Elapsed -->

</androidx.constraintlayout.widget.ConstraintLayout>

<ImageView
android:id="@+id/target_icon"
android:layout_width="75dp"
android:layout_height="62dp"
android:layout_marginStart="35dp"
android:layout_marginBottom="33dp"
app:layout_constraintBottom_toTopOf="@+id/bottom_info_section"
app:layout_constraintStart_toStartOf="parent"
android:src="@drawable/target_icon" />
</androidx.constraintlayout.widget.ConstraintLayout>
